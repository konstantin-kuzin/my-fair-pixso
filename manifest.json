{
    "manifest_version": 3,
    "name": "Pixso My Plugins Trimmer",
    "version": "1.2.2",
    "description": "Удаляет лишние строки My Plugins, экспорт .pix, автоэкспорт, шаблон имени файла при загрузке .pix.",
    "permissions": ["storage", "alarms", "downloads"],
    "background": {
      "service_worker": "background.js"
    },
    "options_page": "options.html",
    "web_accessible_resources": [
      {
        "resources": ["export-bridge.js"],
        "matches": ["https://pixso.net/*", "https://*.pixso.net/*"]
      }
    ],
    "host_permissions": [
      "https://pixso.net/*",
      "https://*.pixso.net/*"
    ],
    "content_scripts": [
      {
        "matches": ["https://pixso.net/*", "https://*.pixso.net/*"],
        "js": ["content-script.js"],
        "run_at": "document_idle"
      }
    ]
  }