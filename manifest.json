{
    "manifest_version": 3,
    "name": "3.14 XO",
    "version": "1.2",
    "description": "Скрывает неудаляемые Enterprise plugins, добавляет кнопку сохранения в тулбар, добавляет автоэкспорт в .pix с настраиваемым периодом и шаблоном имени,",
    "permissions": ["storage", "alarms", "downloads"],
    "background": {
      "service_worker": "background.js"
    },
    "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "action": {
      "default_title": "Настройки",
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png"
      }
    },
    "web_accessible_resources": [
      {
        "resources": ["export-bridge.js"],
        "matches": ["https://pixso.net/*", "https://*.pixso.net/*"]
      }
    ],
    "host_permissions": [
      "https://pixso.net/*",
      "https://*.pixso.net/*"
    ],
    "content_scripts": [
      {
        "matches": ["https://pixso.net/*", "https://*.pixso.net/*"],
        "js": ["content-script.js"],
        "run_at": "document_idle"
      }
    ]
  }